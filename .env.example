# InsForge Configuration
# Public vars (safe to expose — anon role, RLS-gated):
PUBLIC_INSFORGE_URL=https://shneyhp8.us-west.insforge.app
PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key
# Server-only admin key (project_admin — bypasses RLS). Used by
# netlify/functions/chat-api.js (chat_logs read/write) and cms-publish.js
# (cms_admins allowlist check). NEVER prefix with PUBLIC_.
INSFORGE_URL=https://shneyhp8.us-west.insforge.app
INSFORGE_API_KEY=your_insforge_api_key
# Get these from: npx -y @insforge/cli secrets get ANON_KEY / API_KEY

# AI Configuration (existing)
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key
KIMI_API_KEY=your_kimi_api_key

# Email Configuration (existing)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# CMS Configuration
# CMS admin authentication is handled by InsForge Auth. Create an admin user
# (email + password) in the InsForge dashboard (Auth -> Users -> Add user), then
# allowlist that email in the cms_admins table (SQL editor or CLI db query).
# The /admin dashboard signs in via insforge.auth.signInWithPassword. No
# client-side password env var is used; RLS enforces CMS writes via
# public.is_cms_admin(). Public signup is disabled (insforge.toml ->
# disable_signup = true).

# CMS Publish Backend (server-only; used by netlify/functions/cms-publish.js).
# The function supports two backends and picks based on which env var is set
# (no code change needed to switch):
#
#   1. GitHub repository_dispatch (primary, while the Netlify site is NOT
#      git-linked). The function POSTs an event to the GitHub API, which
#      triggers .github/workflows/cms-publish.yml to build with Bun and run
#      `netlify deploy --prod`. Requires a fine-grained GitHub PAT scoped to
#      this repo with Contents: read and write.
GITHUB_DISPATCH_TOKEN=github_pat_your_fine_grained_pat
GITHUB_REPO=davisk360/new-media-tek
#
#   2. Netlify build hook (fallback, after upgrading to Pro and git-linking the
#      repo). Unset GITHUB_DISPATCH_TOKEN and set this instead. NEVER expose
#      client-side — it is not a PUBLIC_ var.
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/your_hook_id
#
# The GitHub Actions workflow also needs two GitHub repo secrets (set in
# GitHub repo settings -> Secrets and variables -> Actions):
#   NETLIFY_AUTH_TOKEN  = a Netlify personal access token (for `netlify deploy`)
#   NETLIFY_SITE_ID     = 0f24ae87-1497-4b48-b3f4-ef32eb8adc8c

# Chatbot Prompts (loaded from Netlify Blobs by chat-api.js, NOT env vars, to stay
# under the AWS Lambda 4KB env limit in Lambda compatibility mode).
# Populate with: netlify blobs:set chat-prompts system_prompt --input <file>
#                netlify blobs:set chat-prompts guard_prompt --input <file>
# See CHATBOT-SECURITY.md for details.

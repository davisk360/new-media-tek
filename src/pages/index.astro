          ];

          let currentSnippetIndex = 0;
          let isTyping = false;

          const colorMap = {
            blue: 'text-blue-400',
            purple: 'text-purple-400',
            cyan: 'text-cyan-400',
            green: 'text-emerald-400',
            gray: 'text-slate-500 italic'
          };

          async function typeWriter(lines) {
            isTyping = true;
            codeContainer.innerHTML = '';

            for (let lineIndex = 0; lineIndex < lines.length; lineIndex++) {
              if (!document.body.contains(codeContainer)) {
                log('[NM] Code container lost during typing');
                return;
              }

              const tokens = lines[lineIndex];
              const lineDiv = document.createElement('div');
              lineDiv.className = 'flex items-center h-6';
              codeContainer.appendChild(lineDiv);

              for (let tokenIndex = 0; tokenIndex < tokens.length; tokenIndex++) {
                const token = tokens[tokenIndex];
                const text = token.t;
                const colorClass = token.c ? colorMap[token.c] : 'text-slate-300';
                const tokenSpan = document.createElement('span');
                tokenSpan.className = colorClass;
                lineDiv.appendChild(tokenSpan);

                for (let charIndex = 0; charIndex < text.length; charIndex++) {
                  if (!document.body.contains(codeContainer)) return;
                  tokenSpan.textContent += text[charIndex];
                  await new Promise(r => setTimeout(r, 45));
                }
              }
              await new Promise(r => setTimeout(r, 300));
            }

            // Wait before next snippet
            await new Promise(r => setTimeout(r, 5000));

            if (!document.body.contains(codeContainer)) return;

            currentSnippetIndex = (currentSnippetIndex + 1) % codeSnippets.length;
            if (filenameSpan) filenameSpan.textContent = codeSnippets[currentSnippetIndex].filename;
            typeWriter(codeSnippets[currentSnippetIndex].lines);
          }

          if (filenameSpan) filenameSpan.textContent = codeSnippets[0].filename;
          typeWriter(codeSnippets[0].lines);
        } else {
          log('[NM] Code container NOT found');
        }
      };

      // Robust Listener Management
      // 1. Remove previous listener if exists (from previous page visit)
      if (window.nmSetupAnimations) {
        document.removeEventListener('astro:page-load', window.nmSetupAnimations);
      }

      // 2. Assign new listener
      window.nmSetupAnimations = setupAnimations;

      // 3. Add listener
      document.addEventListener('astro:page-load', window.nmSetupAnimations);
      log('[NM] Listener attached');

    })();

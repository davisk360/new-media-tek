              lines: [
                [{t:'import', c:'blue'}, {t:' '}, {t:'pandas', c:'cyan'}, {t:' '}, {t:'as', c:'blue'}, {t:' pd'}],
                [{t:'from', c:'blue'}, {t:' '}, {t:'sklearn.model_selection', c:'cyan'}, {t:' '}, {t:'import', c:'blue'}, {t:' train_test_split'}],

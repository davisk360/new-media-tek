---
// Header component with navigation
// Following Astro best practices for component structure
---

<nav class="fixed top-0 w-full z-50 border-b bg-[#030712]/70 backdrop-blur-xl transition-all duration-300 border-white/5">
  <div class="flex h-16 max-w-7xl mx-auto px-3 sm:px-6 items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 sm:gap-3 group min-w-0">
      <div class="relative flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 group-hover:scale-110 transition-all duration-300 ease-out flex-shrink-0 drop-shadow-[0_0_10px_rgba(34,211,238,0.4)] hover:drop-shadow-[0_0_15px_rgba(34,211,238,0.6)]">
        <img src="/images/logo-icon.png" alt="New Media Tek Logo" class="w-full h-full object-contain filter brightness-110" />
      </div>
      <div class="flex flex-col leading-none min-w-0">
        <span class="group-hover:text-blue-200 transition-colors text-xs sm:text-sm font-medium text-white tracking-tight truncate">New Media Tek</span>
        <span class="text-[8px] sm:text-[10px] font-medium uppercase tracking-widest text-slate-400 group-hover:text-cyan-300 transition-colors hidden xs:block">Enterprise .NET Development</span>
      </div>
    </a>
    
    <!-- Desktop Navigation (centered) -->
    <div class="hidden md:flex items-center gap-8">
      <a href="/services" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Services</a>
      <a href="/insights" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Insights</a>
      <a href="/about" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">About</a>
      <a href="/portfolio" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Portfolio</a>
      <a href="/process" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Process</a>
      <a href="/contact" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Contact</a>
    </div>
    
    <!-- CTA Button (right) -->
    <div class="hidden md:flex items-center">
      <a href="/contact" class="h-10 px-6 rounded-full text-sm font-semibold transition-colors flex items-center gap-2 shadow-[0_0_20px_-5px_rgba(255,255,255,0.3)] bg-white text-slate-950 hover:bg-slate-200">
        <i data-lucide="phone" class="w-4 h-4"></i> Schedule Consultation
      </a>
    </div>
    
    <!-- Mobile Menu Button -->
    <button onclick="toggleMobileMenu()" class="md:hidden flex items-center gap-1 sm:gap-2 text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition-colors flex-shrink-0 p-2">
      <i data-lucide="menu" class="w-5 h-5"></i>
      <span class="hidden xs:inline">Menu</span>
    </button>
  </div>
</nav>
